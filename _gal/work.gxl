// gx 工作入口（与 wist-cred-stack / wist-gateway-stack 同一套）。
//
// `operators` 是本栈自己的运维流程（`sys/workflows/operators.gxl`）：
// `gops sys localize` 写完栈根 `.env` 之后会执行 `gx run localize`（galaxy-ops >= 1.3.4 /
// galaxy-flow >= 0.14），configs/ 的渲染就在那里。
extern mod operators { path = "./sys/workflows"; };

mod envs  {

  #[usage(desp="default", color="green")]
  env default     {}
}

mod main : operators {
}
