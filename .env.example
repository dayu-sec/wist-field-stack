# 手工 `docker compose` 用的默认值（产品默认，与 sys/merged_vars.yml 一致）。
# `gops sys localize` 会生成同名 `.env`（现场值覆盖这里）；CI 的 `docker compose config`
# 校验也用这份，所以**它是入库文件**。改产品默认请改 sys/setting/vars.yml 再 `gops sys update`，
# 并把 sys/merged_vars.yml 一起提交 —— dev/tests/env-example-drift.test.sh 钉住两者逐键一致。
FIELD_REGISTRY=ghcr.io/dayu-sec
FIELD_API_IMAGE_TAG=v0.6.7-alpha
FIELD_WEB_IMAGE_TAG=v0.2.7-alpha
EVIDENCE_IMAGE_TAG=v0.1.15-alpha

ATLAS_REGISTRY=ghcr.io/dayu-sec
ATLAS_IMAGE_TAG=v0.3.3

PG_REGISTRY=docker.io/library
PG_IMAGE_TAG=16

# 浏览器入口（前面应该有 VPN / 堡垒机）
WEB_BIND_IP=127.0.0.1
WEB_HOST_PORT=8088
WEB_DOMAIN=localhost

# 证据写端口：数据面 http_sink 的投递目标（现场改成内网地址）
EVIDENCE_SINK_BIND_IP=127.0.0.1
EVIDENCE_SINK_HOST_PORT=18800
# 「接入」页展示的写端点主机名（数据面视角；每个部署实例不同）
EVIDENCE_SINK_PUBLIC_HOST=127.0.0.1

# 凭据收数监听（field-api 的 mTLS）：wist-cred 推摘要到这里
CREDENTIALS_BIND_IP=127.0.0.1
CREDENTIALS_HOST_PORT=18802

# 身份：认证系统名（= cred 侧 peer 名，凭据的 audience 必须等于它）
FIELD_API_AUDIENCE=wist-field-api

# 自注册：cred 入口 / 本机对外收数地址（= 证书 SAN）
FIELD_API_CRED_URL=
FIELD_API_ADVERTISE_HOST=
FIELD_API_CRED_CA_FILE=
FIELD_API_CRED_INSECURE_TLS=false
FIELD_API_REQUIRE_CRED_SIGNATURE=false

# 证据读端口（容器内；evidence 配置 / 健康检查 / field-api base_url 共用这一个值）
EVIDENCE_READ_PORT=8443
# 证据服务的租户 = 客户 id（BFF 读的就是这个客户的数据；每个站点不同）
EVIDENCE_TENANT=c-001

# 资产拓扑写端口：数据面 wparse 投 DSNAP（现场改成内网地址）
ATLAS_INGEST_BIND_IP=127.0.0.1
ATLAS_INGEST_HOST_PORT=18801
ATLAS_INGEST_PUBLIC_HOST=127.0.0.1
# 写探针：往保留租户写一份最小 DSNAP，验「转换 → 落库 → 物化」
ATLAS_PROBE=on
ATLAS_PROBE_INTERVAL_SECS=300

# 运行指标（VictoriaMetrics）：数据面 remote write 进来，运维从这里查
VM_REGISTRY=quay.io/victoriametrics
VM_IMAGE_TAG=v1.154.0
VM_BIND_IP=127.0.0.1
VM_HOST_PORT=18428
VM_RETENTION=30d
# 数据面视角的 VM 主机名（接入页写端点用；与 *_BIND_IP 是一对）
METRICS_SINK_PUBLIC_HOST=127.0.0.1

PG_BIND_IP=127.0.0.1
EVIDENCE_PG_HOST_PORT=55434
ATLAS_PG_HOST_PORT=55435
EVIDENCE_PG_DB=wist_evidence
EVIDENCE_PG_USER=evidence
EVIDENCE_PG_PASSWORD=evidence-dev-only
ATLAS_PG_DB=wist_atlas
ATLAS_PG_USER=atlas
ATLAS_PG_PASSWORD=atlas-dev-only

# 资产拓扑读接口令牌：**故意没有产品默认值**。
# 现场必须覆盖（`ATLAS_API_TOKEN`，可写 `${SEC_ATLAS_API_TOKEN}`）；空串 = atlas 启动失败。
ATLAS_API_TOKEN=

# 数据落点（PG / 指标 / 证据正文 / 凭据摘要表）：多客户切换时改这几行 + EVIDENCE_TENANT
# 默认值 = 既有落点；多客户时改成带客户 id 的绝对路径，详见 sys/setting/vars.yml 的说明
EVIDENCE_PG_DATA=evidence-pgdata
ATLAS_PG_DATA=atlas-pgdata
VM_DATA=metrics-data
EVIDENCE_OBJECTS_DIR=./data/evidence-objects
FIELD_API_STORE_DIR=./data/field-api

TZ=Asia/Shanghai
