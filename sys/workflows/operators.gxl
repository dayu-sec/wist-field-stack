// 系统运维流程（**本地定义**，不引外部 ops-gxl 模块）。
//
// 由 `_gal/work.gxl` 的 `mod main : operators` 纳入，gops 以 `gx run <flow>` 调用。
// 约定：GXL 行注释是 //（# 是注解语法 #[...]，不是注释）。
mod operators {

  // 阶段扩展点：`gops sys localize` 写完栈根 `.env` 之后执行 `gx run localize`。
  //
  // 合并后的配置以**环境变量**注入本子进程，脚本用 ${VAR:-默认值} 读（默认值与
  // `sys/setting/vars.yml` 一致，只在「不走 gops、直接 `gx run localize`」时兜底）。
  // 每个动作都**幂等**：证书/密钥绝不能每次重生成，渲染值与产物一致时不落盘。
  //
  // 这就是 0.3.0 之前 `init-stack.sh` 里 `copy_missing` 的替代：
  // **configs/ 是渲染产物，不再是一次性拷贝** —— 升级换的是模板，localize 之后运行态
  // 自动跟上（旧做法的症状：栈升了、`configs/` 还是旧的，新加的 `[metrics] write_url`
  // 永远不出现）。
  flow localize {
    // ① 备料渲染值：configs/{field-api,evidence}/*.value.json。
    //    为什么必须是脚本、不能在 GXL 里 printf：GXL 字符串**不还原 `\"`**，而 Ubuntu 的
    //    /bin/sh 是 dash（printf 不认 `\"`，会把反斜杠写进文件）→ 非法 JSON →
    //    gx.tpl 报 `parse json data file`；macOS 上 sh 是 bash 则看起来正常。
    //    详见 sys/scripts/init-field-config.sh 头部注释（与 wist-gateway-stack 的 init-web-conf.sh 同因）。
    gx.cmd ( "./sys/scripts/init-field-config.sh" );

    // ② 渲染 BFF 配置：模板 + value.json → configs/field-api/field-api.toml
    //    非密钥的部署值（端口 / 数据面视角的主机名 / 租户）由模板渲染成字面量；
    //    `${SEC_…}` 一律留在模板里，由服务启动时从 `.wist/sec-value.yml` 展开（密钥不落盘）。
    gx.tpl (
      tpl  : "./sys/configs/field-api/field-api.toml.tpl",
      dst  : "./configs/field-api/field-api.toml",
      file : "./configs/field-api/field-api.value.json"
    );

    // ③ 渲染 cred 接入配置：`[verify]` 认谁、`[publish]` 本机在 cred 眼里的收数地址。
    //    它盖在 `/cred/cred.toml` 上，接入命令（join.sh）写的那份只贡献**材料**，不贡献 [verify]。
    gx.tpl (
      tpl  : "./sys/configs/field-api/cred.toml.tpl",
      dst  : "./configs/field-api/cred.toml",
      file : "./configs/field-api/cred.value.json"
    );

    // ④ 渲染证据服务配置：读监听端口渲染成字面量；DB URL / COS 凭据仍是 `${SEC_…}`。
    gx.tpl (
      tpl  : "./sys/configs/evidence/wist-evidence.toml.tpl",
      dst  : "./configs/evidence/wist-evidence.toml",
      file : "./configs/evidence/wist-evidence.value.json"
    );

    // ④b 云资产采集（wist-harvest）服务配置：sink 端点是**现场值**（本栈不跑 wparse，
    //     采集往数据面投），所以走渲染而不能写死。渲染值里同时带「启不启用」，
    //     关掉时这份文件仍然存在且可解释（详见脚本 ⑥）。
    gx.tpl (
      tpl  : "./sys/configs/harvest/harvest.toml.tpl",
      dst  : "./configs/harvest/harvest.toml",
      file : "./configs/harvest/harvest.value.json"
    );

    // ④c 云资产采集的数据源：`sources.d/source.toml`。
    //     文件名是**字面量**（gx.tpl 的 dst 不认变量），容器那边的 `--source` 写的是同一个名字；
    //     数据源身份是文件里的 `source_code`，**不是文件名** —— 两边都不许自取名字。
    gx.tpl (
      tpl  : "./sys/configs/harvest/sources.d/source.toml.tpl",
      dst  : "./configs/harvest/sources.d/source.toml",
      file : "./configs/harvest/harvest.value.json"
    );

    // ⑤ 渲染前端站点配置。**没有渲染值**（`data: "{}"`）：这份 tpl 里没有站点相关的量
    //    （`server_name _` 是有意的 —— 入口只有一张证书、一个 server），它走 tpl 只为了
    //    「跟版本走」：新版本给 nginx 加了 `location /__init`，升级后不会再停留在旧文件上。
    gx.tpl (
      tpl  : "./sys/configs/web/nginx.conf.tpl",
      dst  : "./configs/web/nginx.conf",
      data : "{}"
    );

    // ⑥ 运行态备料（幂等）：目录 / 密钥文件 / 自注册 setup code / cred 材料自检 / web TLS /
    //    harvest 的 spool+state。
    //    放在渲染**之后**：它要检查刚渲染出来的 `configs/field-api/cred.toml` 有没有 `[init]`，
    //    并把 `configs/**` 的权限收成 0644；harvest 的 spool/state 也必须建在 perms 之前。
    gx.cmd ( "./sys/scripts/init-stack.sh" );

    // ⑦ 宿主侧属主/权限对齐（Linux 专有；macOS / OrbStack 直接跳过）：
    //    evidence / field-api 以 10001 运行，而 Linux 的 bind 挂载**不改属主** —— 未对齐会稳定地造成
    //    证据服务读不到 `/sec/sec-value.yml`、field-api 读不到 `/cred/server.key`。
    //    用 `gops sys perms --apply`（gops >= 2.7）：它从 `docker compose config` 派生
    //    「哪些挂载要写、哪些只读」，不需要本仓维护名单。
    //    必须在 localize **最后**（前面几步会新建/重写文件），也必须在 `docker compose up` 之前
    //    （Docker 会把缺失的挂载源建成 root:root，之后就写不动了）。
    gx.cmd ( "gops sys perms --help >/dev/null 2>&1 || { echo '错误：本栈需要 gops >= 2.7（gops sys perms）'; exit 1; }; gops sys perms --apply" );
  }
}
