# gops 生成物 / 现场态
.env
.wist/
sys/.wist/
values/
sys/resolved_vars.yml
deliver.lock

# macOS
.DS_Store

# gx 运行物（`gx run` 生成的报告与运行记录；同 wist-cred-stack / wist-gateway-stack）
.report
.run*
_gal/.report/

# 迁移（gops >= 1.4）：模块按目标模型分组
sys/*/mods

# gops 栈根运行态（init-stack.sh 从 sys/configs 复制）
/configs/

# 证据正文（objects.kind = file 的落点）
/data/

# 客户数据根（`FIELD_DATA_ROOT` 默认 `./customers`：每客户 pg/ 与 objects/）
/customers/
